# Copy to .env and fill in real values for anything beyond local dev.
# Every variable here is read by content_studio/config.py with the CS_
# prefix (e.g. CS_JWT_SECRET) via pydantic-settings. Nothing is required
# to run locally against the docker-compose stack — the defaults in
# config.py already point at it — but the values marked MUST CHANGE below
# are dev-only placeholders that must never reach a real deployment.

# --- Database (PostgreSQL is the sole authoritative store) -----------------
CS_DATABASE_URL=postgresql+asyncpg://content_studio:content_studio_dev@localhost:5432/content_studio

# This backend's own publicly-reachable base URL — used to build callback
# URLs handed to third parties (e.g. the WooCommerce webhook delivery_url).
# MUST CHANGE for any non-local deployment to the real public API URL.
CS_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Comma-separated origins allowed to call this API from a browser (CORS).
# MUST CHANGE for any non-local deployment to the real frontend domain(s).
CS_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth --------------------------------------------------------------
# MUST CHANGE for any non-local deployment — this is a published, public
# placeholder. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CS_JWT_SECRET=dev-only-change-me
CS_JWT_ALGORITHM=HS256
CS_ACCESS_TOKEN_TTL_MINUTES=15
CS_REFRESH_TOKEN_TTL_DAYS=30

# --- Redis (cache/coordination only — never authoritative data) ------------
# Use 127.0.0.1, not localhost, if you're on Windows — see
# windows_dev_gotchas.md for why redis.asyncio specifically needs this.
CS_REDIS_URL=redis://127.0.0.1:6379/0

# --- Object storage (SeaweedFS, S3-compatible) ------------------------------
CS_OBJECT_STORAGE_ENDPOINT=http://localhost:8333
# Publicly-reachable endpoint used only for presigned GET URLs handed to the
# browser (e.g. a Coolify HTTPS domain routed to the seaweedfs service).
# Leave empty in local dev, where CS_OBJECT_STORAGE_ENDPOINT is already
# browser-reachable. MUST be set for any non-local deployment or every
# generated image/audio asset renders as broken in the browser.
CS_OBJECT_STORAGE_PUBLIC_ENDPOINT=
CS_OBJECT_STORAGE_BUCKET=content-studio-assets
# MUST CHANGE for any non-local deployment.
CS_OBJECT_STORAGE_ACCESS_KEY=dev
CS_OBJECT_STORAGE_SECRET_KEY=dev-secret

# --- Temporal ------------------------------------------------------------
CS_TEMPORAL_TARGET=localhost:7233
CS_TEMPORAL_NAMESPACE=default
CS_TEMPORAL_TASK_QUEUE=content-studio

# --- Open Policy Agent -----------------------------------------------------
CS_OPA_URL=http://localhost:8181

# --- Observability (OpenTelemetry Collector) --------------------------------
CS_OTEL_EXPORTER_ENDPOINT=http://localhost:4317
CS_ENVIRONMENT=development

# --- AI text (OpenRouter or a self-hosted LiteLLM Proxy) --------------------
# Empty CS_AI_TEXT_API_KEY means "no real provider configured" — the app
# falls back to a deterministic stub adapter so it runs out of the box
# without any paid keys. Set a real key to use real generation.
CS_AI_TEXT_BASE_URL=https://openrouter.ai/api/v1
CS_AI_TEXT_API_KEY=
CS_AI_TEXT_DEFAULT_MODEL=openai/gpt-4o-mini
# Plain language name, injected into a system prompt ("Always respond in
# {value}..."). Empty string = no instruction, output just follows
# whatever language the brief itself is written in.
CS_AI_TEXT_OUTPUT_LANGUAGE=Greek

# --- AI image/audio (Replicate) ---------------------------------------------
# Empty CS_REPLICATE_API_TOKEN means "use the stub image/audio adapters" —
# same dev-mode-fallback pattern as CS_AI_TEXT_API_KEY.
CS_REPLICATE_API_TOKEN=
CS_AI_IMAGE_DEFAULT_MODEL=black-forest-labs/flux-kontext-pro
CS_AI_AUDIO_DEFAULT_MODEL=jaaari/kokoro-82m

# --- OpenBao (secret sealing — tokens/keys are never stored in plaintext) ---
# MUST CHANGE for any non-local deployment.
CS_OPENBAO_URL=http://localhost:8200
CS_OPENBAO_TOKEN=dev-root-token
CS_OPENBAO_SECRET_MOUNT=secret

# --- Social platform OAuth apps (Phase 3) -----------------------------------
# Empty client_id means "use the stub adapter" for facebook/instagram —
# TikTok/YouTube always use the stub regardless (no real adapter built).
# Register a Meta Developer App, add yourself as Admin/Developer/Tester
# (avoids App Review for personal use), request pages_show_list,
# pages_read_engagement, pages_manage_posts, instagram_basic,
# instagram_content_publish.
CS_SOCIAL_OAUTH_CLIENT_ID=
CS_SOCIAL_OAUTH_CLIENT_SECRET=
# Points at the FRONTEND callback route (apps/web's /oauth/callback page),
# not this backend directly — Meta redirects the browser here, and that
# page calls this API's /publishing/oauth/callback itself with the code.
# Must exactly match the redirect URI configured in the Meta App.
CS_SOCIAL_OAUTH_REDIRECT_BASE_URL=http://localhost:3000/oauth/callback

# --- Store connector OAuth apps (Phase 6) -----------------------------------
# Empty client_id means "use the stub adapter" — no real WooCommerce/
# Shopify app is registered by default.
CS_STORE_OAUTH_CLIENT_ID=
CS_STORE_OAUTH_CLIENT_SECRET=
CS_MAX_WEBHOOK_BODY_BYTES=1000000
