# Copy to .env in this directory (infra/docker-compose/) to override the
# dev-safe fallbacks baked into docker-compose.prod.yml. Docker Compose
# reads .env from the compose file's own directory automatically — this is
# a separate file from backend/.env.example (that one is for the bare-process
# local dev workflow; pydantic-settings reads it directly, not via compose).

CS_ENVIRONMENT=production
CS_JWT_SECRET=
CS_OPENBAO_TOKEN=
CS_AI_TEXT_API_KEY=
CS_REPLICATE_API_TOKEN=

# Public API URL the *browser* will call — baked into the frontend bundle
# at build time, so this must be set correctly before `docker compose build`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
